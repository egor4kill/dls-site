<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.brand.full }} — на главную">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-text">
        <b>{{ site.brand.short }}</b>
        <span>{{ site.brand.full }}</span>
      </span>
    </a>

    <nav class="site-nav" id="siteNav" aria-label="Основное меню">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url | url }}" {% if page.url == item.url %}class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
        <li class="nav-cta">
          <a class="cta-btn cta-btn--compact" href="{{ site.telegram.url }}" target="_blank" rel="noopener">В движение <span aria-hidden="true">↗</span></a>
        </li>
      </ul>
    </nav>

    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Включить тёмную тему" aria-pressed="false">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Открыть меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
